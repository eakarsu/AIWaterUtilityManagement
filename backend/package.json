  "description": "AI Water Utility Management System - Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:init": "psql -v ON_ERROR_STOP=1 -f db/schema.sql",
